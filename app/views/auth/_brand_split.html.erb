<%# Split-Layout für Auth-Seiten (Brand-Panel links, Formular rechts). Vorbild: mockups/auth.html %>
<div class="min-h-screen grid lg:grid-cols-2">
  <div class="hidden lg:flex flex-col justify-between bg-violet-600 text-white p-12">
    <%= link_to root_path, class: "flex items-center gap-2" do %>
      <span class="grid place-items-center w-9 h-9 rounded-lg bg-white text-violet-600 font-bold">K</span>
      <span class="text-lg font-bold tracking-tight">Kursverwaltung</span>
    <% end %>
    <div class="max-w-sm">
      <h2 class="text-3xl font-extrabold tracking-tight leading-tight">Lerne die Fähigkeiten, die dich weiterbringen.</h2>
      <p class="mt-4 text-violet-100 leading-relaxed">Expertengeführte Kurse, selbstbestimmt im eigenen Tempo.</p>
    </div>
    <p class="text-xs text-violet-200">© <%= Date.current.year %> Kursverwaltung</p>
  </div>

  <div class="flex items-center justify-center p-6 sm:p-12">
    <div class="w-full max-w-sm">
      <%= link_to root_path, class: "lg:hidden flex items-center gap-2 mb-8" do %>
        <span class="grid place-items-center w-8 h-8 rounded-lg bg-violet-600 text-white font-bold">K</span>
        <span class="text-lg font-bold tracking-tight">Kursverwaltung</span>
      <% end %>

      <% if alert.present? %>
        <p class="mb-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 border border-red-200"><%= alert %></p>
      <% end %>
      <% if notice.present? %>
        <p class="mb-6 rounded-lg bg-green-50 px-4 py-3 text-sm text-green-800 border border-green-200"><%= notice %></p>
      <% end %>

      <%= yield %>
    </div>
  </div>
</div>
