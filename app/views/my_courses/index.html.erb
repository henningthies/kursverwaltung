<% content_for :title, "Meine Kurse" %>

<main class="max-w-6xl mx-auto px-6 py-10">
  <div class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-wide text-violet-700 mb-2">Meine Lernreise</p>
    <h1 class="text-3xl font-extrabold tracking-tight text-gray-900">Willkommen zurück, <%= current_user.name.split.first %></h1>
    <p class="mt-1 text-gray-600">Mach genau da weiter, wo du aufgehört hast.</p>
  </div>

  <div class="grid gap-4 sm:grid-cols-3 mb-10">
    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm text-gray-500">Aktive Kurse</p>
      <p class="mt-1 text-3xl font-extrabold tracking-tight text-gray-900"><%= @active.size %></p>
    </div>
    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm text-gray-500">Auf der Warteliste</p>
      <p class="mt-1 text-3xl font-extrabold tracking-tight text-gray-900"><%= @waitlisted.size %></p>
    </div>
    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <p class="text-sm text-gray-500">Abgeschlossen</p>
      <p class="mt-1 text-3xl font-extrabold tracking-tight text-gray-900"><%= @done.size %></p>
    </div>
  </div>

  <% if @enrollments.empty? %>
    <div class="rounded-xl border border-gray-200 bg-white p-10 text-center">
      <p class="text-gray-600">Du hast noch keine Kurse gebucht.</p>
      <%= link_to "Kurse entdecken", root_path,
            class: "mt-4 inline-block rounded-lg bg-violet-600 px-5 py-2.5 text-white font-medium hover:bg-violet-700" %>
    </div>
  <% else %>
    <% if @active.any? %>
      <section class="mb-10">
        <h2 class="text-xl font-bold tracking-tight text-gray-900 mb-5">Aktiv</h2>
        <div class="space-y-4">
          <%= render partial: "my_courses/enrollment_card", collection: @active, as: :enrollment %>
        </div>
      </section>
    <% end %>

    <% if @waitlisted.any? %>
      <section class="mb-10">
        <h2 class="text-xl font-bold tracking-tight text-gray-900 mb-5">Warteliste</h2>
        <div class="space-y-4">
          <%= render partial: "my_courses/enrollment_card", collection: @waitlisted, as: :enrollment %>
        </div>
      </section>
    <% end %>

    <% if @done.any? %>
      <section class="mb-10">
        <h2 class="text-xl font-bold tracking-tight text-gray-900 mb-5">Abgeschlossen</h2>
        <div class="space-y-4">
          <%= render partial: "my_courses/enrollment_card", collection: @done, as: :enrollment %>
        </div>
      </section>
    <% end %>
  <% end %>
</main>
