<% course = enrollment.course %>
<div class="rounded-xl border border-gray-200 bg-white p-5 hover:border-gray-300 transition flex flex-col sm:flex-row gap-5">
  <div class="w-full sm:w-40 aspect-[16/9] rounded-lg bg-gradient-to-br from-violet-500 to-violet-700 grid place-items-center shrink-0">
    <span class="text-white/90 text-2xl font-extrabold tracking-tight"><%= course.title.split.map(&:first).first(2).join.upcase %></span>
  </div>
  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-3">
      <div>
        <% if course.category %>
          <span class="text-xs font-semibold uppercase tracking-wide text-violet-700"><%= course.category.name %></span>
        <% end %>
        <h3 class="text-lg font-semibold text-gray-900 mt-0.5"><%= course.title %></h3>
        <p class="text-sm text-gray-500 mt-0.5">
          <%= course.instructor.presence || "Ohne Leitung" %>
          <% if (next_session = course.sessions.ordered.first)&.starts_at %>
            · Nächster Termin: <%= l(next_session.starts_at, format: :long) %>
          <% end %>
        </p>
      </div>
      <%= enrollment_status_badge(enrollment) %>
    </div>

    <% if enrollment.status == "waitlisted" %>
      <div class="mt-4 rounded-lg bg-amber-50 border border-amber-100 px-3 py-2 text-sm text-amber-800">
        Du stehst auf der Warteliste. Wird ein Platz frei, rückst du automatisch nach.
      </div>
    <% else %>
      <div class="mt-4">
        <div class="flex items-center justify-between text-xs text-gray-500 mb-1.5">
          <span>Fortschritt</span><span>Noch nicht gestartet</span>
        </div>
        <div class="h-2 rounded-full bg-gray-100 overflow-hidden">
          <div class="h-full w-0 rounded-full bg-violet-600"></div>
        </div>
      </div>
    <% end %>

    <div class="mt-4 flex gap-2">
      <%= link_to "Details", catalog_course_path(course),
            class: "rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
    </div>
  </div>
</div>
