<% content_for :title, "Kurse" %>

<h1 class="text-2xl font-bold mb-6">Kurse</h1>

<% if @courses.any? %>
  <div class="space-y-3">
    <% @courses.each do |course| %>
      <%= link_to course, class: "block rounded-xl border border-gray-200 bg-white p-5 hover:border-gray-300 transition" do %>
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-lg font-semibold text-gray-900"><%= course.title %></h2>
            <%# BEWUSSTE DEMO-SCHWACHSTELLE (T3 Performance): Diese beiden .count-Aufrufe
                je Kurs erzeugen eine N+1-Query (CoursesController#index lädt ohne includes/
                counter_cache). NICHT vorab fixen — das Finden & Beheben ist die Live-Demo. %>
            <p class="text-sm text-gray-500 mt-1">
              <%= course.instructor.presence || "Ohne Leitung" %>
              · <%= pluralize(course.enrollments.confirmed.count, "Anmeldung", plural: "Anmeldungen") %>
              · <%= pluralize(course.sessions.count, "Termin", plural: "Termine") %>
            </p>
          </div>
          <%= course_status_badge(course) %>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-500">Noch keine Kurse vorhanden. <%= link_to "Ersten Kurs anlegen", new_course_path, class: "text-violet-600 hover:underline" %>.</p>
<% end %>
