<% content_for :title, @course.title %>

<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <div class="flex items-center gap-3 mb-2">
      <h1 class="text-2xl font-bold"><%= @course.title %></h1>
      <%= course_status_badge(@course) %>
    </div>
    <p class="text-sm text-gray-500">
      <%= @course.instructor.presence || "Ohne Leitung" %>
      · <%= price_display(@course.price_cents) %>
      <%= "· #{@course.category.name}" if @course.category %>
    </p>
  </div>
  <div class="flex items-center gap-3 shrink-0">
    <%= link_to "Bearbeiten", edit_course_path(@course), class: "text-sm text-gray-600 hover:text-gray-900" %>
    <%= button_to "Löschen", @course, method: :delete,
          class: "text-sm text-red-600 hover:text-red-800",
          data: { turbo_confirm: "Diesen Kurs wirklich löschen?" } %>
  </div>
</div>

<% if @course.description.present? %>
  <div class="rounded-xl border border-gray-200 bg-white p-6 mb-8">
    <p class="whitespace-pre-line text-gray-700"><%= @course.description %></p>
  </div>
<% end %>

<section class="mb-10">
  <h2 class="text-lg font-semibold mb-4">Termine</h2>

  <% if @sessions.any? %>
    <ul class="divide-y divide-gray-200 rounded-xl border border-gray-200 bg-white mb-6">
      <% @sessions.each do |session| %>
        <li class="flex items-center justify-between px-4 py-3">
          <div>
            <p class="font-medium text-gray-900"><%= session.title %></p>
            <% if session.starts_at %>
              <p class="text-sm text-gray-500"><%= l(session.starts_at, format: :long) %></p>
            <% end %>
          </div>
          <%= button_to "Löschen", course_session_path(@course, session), method: :delete,
                class: "text-sm text-red-600 hover:text-red-800",
                data: { turbo_confirm: "Diesen Termin löschen?" } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 mb-6">Noch keine Termine.</p>
  <% end %>

  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <h3 class="font-medium mb-4">Termin hinzufügen</h3>
    <%= form_with model: [@course, @session], class: "space-y-4" do |form| %>
      <% if @session.errors.any? %>
        <div class="rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
          <ul class="list-disc list-inside">
            <% @session.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :title, "Titel", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :title, class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-500 focus:ring-gray-500" %>
      </div>

      <div>
        <%= form.label :starts_at, "Beginn", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.datetime_local_field :starts_at, class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-500 focus:ring-gray-500" %>
      </div>

      <%= form.submit "Termin hinzufügen", class: "rounded-lg bg-violet-600 px-4 py-2 text-sm font-medium text-white hover:bg-violet-700 cursor-pointer" %>
    <% end %>
  </div>
</section>

<%# ===== Bewertungs-Sektion (Admin: alle Reviews inkl. privater, mit Klarnamen) ===== %>
<section class="mb-10">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold">Bewertungen</h2>
    <% if @course.average_rating %>
      <span class="inline-flex items-center gap-1 text-sm text-gray-600">
        <%= star_rating(@course.average_rating, size: "w-4 h-4") %>
        <span class="font-semibold text-gray-900 ml-1"><%= @course.average_rating.to_f.round(1).to_s.sub('.', ',') %></span>
        öffentlich · <%= @course.reviews.count %> gesamt
      </span>
    <% end %>
  </div>
  <p class="text-sm text-gray-500 mb-4">Alle Bewertungen dieses Kurses — öffentliche und private, mit Klarnamen.</p>

  <% if @all_reviews.any? %>
    <div class="rounded-xl border border-gray-200 bg-white divide-y divide-gray-100">
      <% @all_reviews.each do |review| %>
        <div class="flex items-start justify-between gap-4 px-5 py-4 <%= review.visible? ? "" : "bg-gray-50/60" %>">
          <div>
            <div class="flex items-center gap-2">
              <span class="font-semibold text-gray-900"><%= review.user.name %></span>
              <% if review.visible? %>
                <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Öffentlich</span>
                <% if review.anonymous? %>
                  <span class="inline-flex items-center rounded-full bg-violet-100 px-2.5 py-0.5 text-xs font-medium text-violet-800">Anonym angezeigt</span>
                <% end %>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-gray-200 px-2.5 py-0.5 text-xs font-medium text-gray-700">Privat (nur Admin)</span>
              <% end %>
            </div>
            <div class="mt-1 flex items-center gap-0.5">
              <%= star_rating(review.rating, size: "w-4 h-4") %>
            </div>
            <% if review.comment.present? %>
              <p class="mt-1 text-sm text-gray-700">„<%= review.comment %>"</p>
            <% end %>
          </div>
          <%= button_to "Löschen", course_review_path(@course, review), method: :delete,
                class: "rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 shrink-0",
                data: { turbo_confirm: "Bewertung von #{review.user.name} wirklich löschen?" } %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">Noch keine Bewertungen.</p>
  <% end %>
</section>

<section>
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold">Anmeldungen</h2>
    <% if @course.capacity.present? %>
      <span class="text-sm text-gray-500">Kapazität: <%= @course.confirmed_count %> / <%= @course.capacity %></span>
    <% end %>
  </div>

  <%# Bestätigte Anmeldungen %>
  <div class="rounded-xl border border-gray-200 bg-white mb-4">
    <div class="px-5 py-3 border-b border-gray-200">
      <h3 class="text-sm font-semibold text-gray-700">
        Bestätigt
        (<%= @confirmed_enrollments.size %><%= @course.capacity.present? ? " / #{@course.capacity}" : "" %>)
      </h3>
    </div>
    <% if @confirmed_enrollments.any? %>
      <ul class="divide-y divide-gray-200">
        <% @confirmed_enrollments.each do |enrollment| %>
          <li class="flex items-center justify-between px-5 py-3">
            <div class="flex items-center gap-3">
              <%= enrollment_status_badge(enrollment) %>
              <span class="text-sm text-gray-900"><%= enrollment.participant.name %></span>
            </div>
            <%= button_to "Abmelden", course_enrollment_path(@course, enrollment), method: :delete,
                  class: "text-xs text-red-600 hover:text-red-800",
                  data: { turbo_confirm: "#{enrollment.participant.name} wirklich abmelden?" } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-5 py-4 text-sm text-gray-500">Noch keine bestätigten Anmeldungen.</p>
    <% end %>
  </div>

  <%# Warteliste %>
  <div class="rounded-xl border border-gray-200 bg-white mb-6">
    <div class="px-5 py-3 border-b border-gray-200">
      <h3 class="text-sm font-semibold text-gray-700">
        Warteliste (<%= @waitlisted_enrollments.size %>)
      </h3>
    </div>
    <% if @waitlisted_enrollments.any? %>
      <ul class="divide-y divide-gray-200">
        <% @waitlisted_enrollments.each do |enrollment| %>
          <li class="flex items-center justify-between px-5 py-3">
            <div class="flex items-center gap-3">
              <%= enrollment_status_badge(enrollment) %>
              <span class="text-sm text-gray-900"><%= enrollment.participant.name %></span>
            </div>
            <%= button_to "Abmelden", course_enrollment_path(@course, enrollment), method: :delete,
                  class: "text-xs text-red-600 hover:text-red-800",
                  data: { turbo_confirm: "#{enrollment.participant.name} von der Warteliste entfernen?" } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-5 py-4 text-sm text-gray-500">Keine Einträge auf der Warteliste.</p>
    <% end %>
  </div>

  <%# Anmelde-Formular %>
  <div class="rounded-xl border border-gray-200 bg-white p-6">
    <h3 class="font-medium mb-4">Anmelden</h3>
    <%= form_with url: course_enrollments_path(@course), method: :post, class: "space-y-4" do |form| %>
      <% if @participant&.errors&.any? %>
        <div class="rounded-md bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-800">
          <ul class="list-disc list-inside">
            <% @participant.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :name, "Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :name,
              name: "enrollment[name]",
              value: @participant&.name,
              class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-500 focus:ring-gray-500" %>
      </div>

      <div>
        <%= form.label :email, "E-Mail", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.email_field :email,
              name: "enrollment[email]",
              value: @participant&.email,
              class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-gray-500 focus:ring-gray-500" %>
      </div>

      <%= form.submit "Anmelden", class: "rounded-lg bg-violet-600 px-4 py-2 text-sm font-medium text-white hover:bg-violet-700 cursor-pointer" %>
    <% end %>
  </div>
</section>
