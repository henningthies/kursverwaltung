<%# Bewertungsliste: sichtbare Reviews oder Leerzustand. %>
<% if reviews.any? %>
  <div class="space-y-4">
    <% reviews.each do |review| %>
      <figure class="rounded-xl border border-gray-200 bg-white p-5">
        <div class="flex items-center justify-between mb-2">
          <figcaption class="text-sm font-semibold <%= review.anonymous? ? 'text-gray-500 italic' : 'text-gray-900' %>">
            <%= review.display_name %>
          </figcaption>
          <div class="flex items-center gap-0.5">
            <%= star_rating(review.rating) %>
          </div>
        </div>
        <% if review.comment.present? %>
          <blockquote class="text-sm text-gray-700">„<%= review.comment %>"</blockquote>
        <% end %>
      </figure>
    <% end %>
  </div>
<% else %>
  <div class="rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-sm text-gray-500">
    Noch keine Bewertungen — sei die:der Erste.
  </div>
<% end %>
