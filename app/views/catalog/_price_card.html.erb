<div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
  <div class="aspect-[16/10] bg-gradient-to-br from-violet-500 to-violet-700 grid place-items-center">
    <span class="text-white/90 text-5xl font-extrabold tracking-tight">
      <%= course.title.split.map(&:first).first(2).join.upcase %>
    </span>
  </div>
  <div class="p-5">
    <div class="flex items-end gap-2">
      <span class="text-3xl font-extrabold tracking-tight text-gray-900"><%= price_display(course.price_cents) %></span>
    </div>
    <p class="mt-1 text-sm text-gray-500">
      <%= course.free? ? "Kostenlos · sofort buchbar" : "Einmalzahlung · lebenslanger Zugriff" %>
    </p>

    <%# Kapazitäts-/Wartelisten-Zustand aus der bestehenden Course-Logik. %>
    <% if course.full? %>
      <div class="mt-3 rounded-lg bg-amber-50 border border-amber-100 px-3 py-2 text-sm text-amber-800">
        Dieser Kurs ist ausgebucht. Eine Buchung kommt auf die <span class="font-semibold">Warteliste</span>.
      </div>
    <% elsif course.almost_full? %>
      <div class="mt-3 rounded-lg bg-amber-50 border border-amber-100 px-3 py-2 text-sm text-amber-800">
        Nur noch <span class="font-semibold"><%= course.remaining_seats %> von <%= course.capacity %></span> Plätzen frei
      </div>
    <% end %>

    <div class="mt-4 flex flex-col gap-2">
      <%= render "catalog/booking_actions", course: course %>
    </div>

    <p class="mt-4 text-center text-xs text-gray-400">Zahlung erst bei Bestätigung · jederzeit kündbar</p>
  </div>
</div>
