<%# Bewertungs-Modal: Stimulus dialog_controller öffnet/schließt <dialog>. %>
<div data-controller="dialog">
  <button type="button"
          data-action="dialog#open"
          class="rounded-lg bg-violet-600 px-4 py-2 text-sm text-white font-medium hover:bg-violet-700">
    Kurs bewerten
  </button>

  <dialog data-dialog-target="modal"
          class="rounded-2xl p-0 w-full max-w-md backdrop:bg-gray-900/40">
    <div data-controller="rating">
      <%= form_with url: course_reviews_path(course), method: :post, class: "p-6" do |f| %>
        <h3 class="text-lg font-bold tracking-tight text-gray-900">End-of-Term Review</h3>
        <p class="mt-1 text-sm text-gray-600">Vielen Dank für deine Teilnahme! Bitte bewerte diesen Kurs.</p>

        <%# Sterne-Eingabe: Stimulus rating-controller setzt das hidden field. %>
        <div class="mt-5 flex items-center justify-between w-full text-4xl">
          <% (1..5).each do |i| %>
            <button type="button"
                    class="text-gray-300 hover:text-amber-400"
                    data-rating-target="star"
                    data-value="<%= i %>"
                    data-action="mouseover->rating#highlight mouseout->rating#reset click->rating#select">
              ★
            </button>
          <% end %>
        </div>
        <%= f.hidden_field :rating, value: "", data: { rating_target: "input" } %>

        <%= f.text_area :comment, rows: 3,
              placeholder: "Deine ehrliche Meinung (optional)",
              class: "mt-5 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-700 placeholder-gray-400 focus:border-violet-600 focus:ring-violet-600" %>

        <div class="mt-4 space-y-2.5">
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <%= f.check_box :anonymous, class: "rounded border-gray-300 text-violet-600 focus:ring-violet-600" %>
            Ich möchte anonym bewerten
          </label>
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <%= f.check_box :visible, checked: true, class: "rounded border-gray-300 text-violet-600 focus:ring-violet-600" %>
            Meine Bewertung öffentlich anzeigen
          </label>
        </div>

        <div class="mt-6 flex items-center gap-3">
          <%= f.submit "Bewertung absenden",
                class: "rounded-lg bg-violet-600 px-4 py-2 text-sm text-white font-medium hover:bg-violet-700 cursor-pointer" %>
          <button type="button"
                  data-action="dialog#close"
                  class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">
            Vielleicht später
          </button>
        </div>
      <% end %>
    </div>
  </dialog>
</div>
