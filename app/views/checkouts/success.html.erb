<% content_for :title, "Bestellung bestätigt" %>

<main class="max-w-2xl mx-auto px-6 py-16 text-center">
  <div class="inline-grid place-items-center w-14 h-14 rounded-full bg-green-100 text-green-700 mb-6">
    <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
  </div>
  <h1 class="text-3xl font-extrabold tracking-tight text-gray-900">Vielen Dank für deine Buchung!</h1>
  <p class="mt-3 text-gray-600">Deine Bestellung ist eingegangen. Du findest deine Kurse unter „Meine Kurse".</p>

  <% if @order %>
    <div class="mt-8 rounded-xl border border-gray-200 bg-white p-5 text-left">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold text-gray-900">Bestellübersicht</h2>
        <%= order_status_badge(@order) %>
      </div>
      <ul class="divide-y divide-gray-100">
        <% @order.order_items.includes(:course).each do |item| %>
          <li class="flex items-center justify-between py-2 text-sm">
            <span class="text-gray-700"><%= item.course.title %></span>
            <span class="font-medium text-gray-900"><%= price_display(item.price_cents) %></span>
          </li>
        <% end %>
      </ul>
      <div class="flex justify-between border-t border-gray-100 mt-3 pt-3 font-semibold text-gray-900">
        <span>Gesamt</span><span><%= price_display(@order.total_cents) %></span>
      </div>
    </div>
  <% end %>

  <div class="mt-8 flex items-center justify-center gap-3">
    <%= link_to "Zu meinen Kursen", my_courses_path,
          class: "inline-block rounded-lg bg-violet-600 px-5 py-2.5 text-white font-medium hover:bg-violet-700" %>
    <%= link_to "Weiter stöbern", root_path,
          class: "inline-block rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-gray-700 font-medium hover:bg-gray-50" %>
  </div>
</main>
