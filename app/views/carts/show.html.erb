<% content_for :title, "Warenkorb" %>

<div class="max-w-5xl mx-auto px-6 pt-8">
  <ol class="flex items-center gap-3 text-sm font-medium">
    <li class="flex items-center gap-2 text-violet-700"><span class="grid place-items-center w-6 h-6 rounded-full bg-violet-600 text-white text-xs">1</span> Warenkorb</li>
    <li class="flex-1 h-px bg-gray-200"></li>
    <li class="flex items-center gap-2 text-gray-900"><span class="grid place-items-center w-6 h-6 rounded-full bg-violet-100 text-violet-700 text-xs ring-2 ring-violet-600">2</span> Zahlung</li>
    <li class="flex-1 h-px bg-gray-200"></li>
    <li class="flex items-center gap-2 text-gray-400"><span class="grid place-items-center w-6 h-6 rounded-full bg-gray-100 text-gray-500 text-xs">3</span> Bestätigung</li>
  </ol>
</div>

<main class="max-w-5xl mx-auto px-6 py-10 grid lg:grid-cols-3 gap-8 items-start">
  <div class="lg:col-span-2 space-y-6">
    <section class="rounded-xl border border-gray-200 bg-white">
      <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
        <h2 class="font-semibold text-gray-900">Dein Warenkorb</h2>
        <span class="text-sm text-gray-500"><%= pluralize(@cart.size, "Kurs", plural: "Kurse") %></span>
      </div>

      <% if @cart.empty? %>
        <p class="px-5 py-8 text-center text-gray-500">
          Dein Warenkorb ist leer. <%= link_to "Kurse entdecken", root_path, class: "text-violet-700 font-medium hover:underline" %>.
        </p>
      <% else %>
        <div class="divide-y divide-gray-100">
          <% @cart.courses.each do |course| %>
            <div class="flex items-center gap-4 px-5 py-4">
              <div class="w-20 aspect-[16/10] rounded-lg bg-gradient-to-br from-violet-500 to-violet-700 grid place-items-center shrink-0">
                <span class="text-white/90 font-extrabold"><%= course.title.split.map(&:first).first(2).join.upcase %></span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-medium text-gray-900 truncate"><%= course.title %></p>
                <p class="text-sm text-gray-500"><%= course.instructor.presence || "Ohne Leitung" %><%= " · #{course.category.name}" if course.category %></p>
              </div>
              <div class="text-right">
                <p class="font-semibold text-gray-900"><%= price_display(course.price_cents) %></p>
                <%= button_to "Entfernen", remove_item_cart_path(course_id: course.id), method: :delete,
                      class: "text-xs text-gray-400 hover:text-gray-600" %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <% unless @cart.empty? %>
      <section class="rounded-xl border border-gray-200 bg-white p-5">
        <h2 class="font-semibold text-gray-900 mb-1">Zahlung</h2>
        <p class="text-sm text-gray-500 mb-5">Die Zahlung wird sicher über Stripe abgewickelt. Wir speichern keine Kartendaten.</p>
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-5 text-center">
          <p class="font-medium text-gray-900 mb-1">Weiter zu Stripe Checkout</p>
          <p class="text-sm text-gray-600 max-w-md mx-auto">
            Mit „Jetzt bezahlen" wirst du zur sicheren Bezahlseite von Stripe weitergeleitet
            und kommst danach zurück zur Bestätigung.
          </p>
        </div>
        <p class="mt-4 text-xs text-gray-400">Testmodus aktiv — es wird keine echte Zahlung ausgelöst.</p>
      </section>
    <% end %>
  </div>

  <aside class="lg:sticky lg:top-8">
    <div class="rounded-xl border border-gray-200 bg-white p-5">
      <h2 class="font-semibold text-gray-900 mb-4">Bestellübersicht</h2>
      <dl class="space-y-2.5 text-sm border-t border-gray-100 pt-4">
        <div class="flex justify-between text-gray-600"><dt>Zwischensumme</dt><dd><%= price_display(@cart.total_cents) %></dd></div>
      </dl>
      <div class="flex justify-between items-end border-t border-gray-100 mt-4 pt-4">
        <span class="font-semibold text-gray-900">Gesamt</span>
        <span class="text-2xl font-extrabold tracking-tight text-gray-900"><%= price_display(@cart.total_cents) %></span>
      </div>

      <% unless @cart.empty? %>
        <%= button_to (@cart.total_cents.zero? ? "Jetzt buchen" : "Jetzt bezahlen"), checkout_path,
              class: "mt-5 w-full rounded-lg bg-violet-600 px-4 py-3 text-white font-medium hover:bg-violet-700" %>
      <% end %>
      <%= link_to "Weiter stöbern", root_path, class: "mt-2 block text-center text-sm text-gray-500 hover:text-gray-900" %>
    </div>
  </aside>
</main>
