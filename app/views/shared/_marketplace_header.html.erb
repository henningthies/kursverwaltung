<header class="sticky top-0 z-20 bg-white/90 backdrop-blur border-b border-gray-200">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
    <%= link_to root_path, class: "flex items-center gap-2" do %>
      <span class="grid place-items-center w-8 h-8 rounded-lg bg-violet-600 text-white font-bold">K</span>
      <span class="text-lg font-bold tracking-tight">Kursverwaltung</span>
    <% end %>

    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-gray-600">
      <%= link_to "Kurse", root_path, class: "text-violet-700" %>
      <% if logged_in? %>
        <%= link_to "Meine Kurse", root_path, class: "hover:text-gray-900" %>
      <% end %>
      <% if logged_in? && current_user.admin? %>
        <%= link_to "Verwaltung", courses_path, class: "hover:text-gray-900" %>
      <% end %>
    </nav>

    <div class="flex items-center gap-3 text-sm">
      <% if logged_in? %>
        <span class="hidden sm:grid place-items-center w-8 h-8 rounded-full bg-violet-100 text-violet-700 text-xs font-semibold">
          <%= current_user.name.to_s.split.map(&:first).first(2).join.upcase %>
        </span>
        <%= button_to "Abmelden", session_path, method: :delete,
              class: "rounded-lg border border-gray-200 px-4 py-2 font-medium text-gray-700 hover:border-gray-300" %>
      <% else %>
        <%= link_to "Anmelden", new_session_path, class: "hidden sm:inline-block font-medium text-gray-700 hover:text-gray-900" %>
        <%= link_to "Registrieren", new_registration_path,
              class: "rounded-lg bg-violet-600 px-4 py-2 text-white font-medium hover:bg-violet-700" %>
      <% end %>
    </div>
  </div>
</header>
