<header class="bg-white border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-5 py-4 flex items-center justify-between gap-4">
    <%= link_to root_path, class: "flex items-center gap-2 text-lg font-bold tracking-tight text-gray-900 hover:text-gray-600" do %>
      <span class="grid place-items-center w-8 h-8 rounded-lg bg-violet-600 text-white font-bold">K</span>
      Kursverwaltung
    <% end %>

    <nav class="flex items-center gap-4 text-sm">
      <% if logged_in? %>
        <% if current_user.admin? %>
          <%= link_to "Verwaltung", courses_path, class: "text-gray-600 hover:text-gray-900 font-medium" %>
        <% end %>
        <span class="hidden sm:flex items-center gap-2">
          <span class="grid place-items-center w-8 h-8 rounded-full bg-violet-100 text-violet-700 text-xs font-semibold">
            <%= current_user.name.to_s.split.map(&:first).first(2).join.upcase %>
          </span>
          <span class="text-gray-700 font-medium"><%= current_user.name %></span>
        </span>
        <%= button_to "Abmelden", session_path, method: :delete,
              class: "rounded-lg border border-gray-300 bg-white px-3 py-2 font-medium text-gray-700 hover:bg-gray-50" %>
      <% else %>
        <%= link_to "Anmelden", new_session_path, class: "text-gray-600 hover:text-gray-900 font-medium" %>
        <%= link_to "Registrieren", new_registration_path,
              class: "rounded-lg bg-violet-600 px-3 py-2 font-medium text-white hover:bg-violet-700" %>
      <% end %>
    </nav>
  </div>
</header>
