<!DOCTYPE html>
<html lang="de">
  <head>
    <title><%= content_for(:title) || "Verwaltung · Kursverwaltung" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen antialiased">
    <header class="bg-white border-b border-gray-200">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <%= link_to admin_dashboard_path, class: "flex items-center gap-2" do %>
            <span class="grid place-items-center w-8 h-8 rounded-lg bg-violet-600 text-white font-bold">K</span>
            <span class="text-lg font-bold tracking-tight">Kursverwaltung</span>
          <% end %>
          <span class="ml-2 inline-flex items-center gap-1 rounded-full bg-violet-100 px-2.5 py-0.5 text-xs font-medium text-violet-800">Verwaltung</span>
        </div>
        <div class="flex items-center gap-3 text-sm">
          <%= link_to "Zur Lernansicht", root_path, class: "font-medium text-gray-500 hover:text-gray-900" %>
          <% if logged_in? %>
            <%= button_to "Abmelden", session_path, method: :delete,
                  class: "rounded-lg border border-gray-200 px-4 py-2 font-medium text-gray-700 hover:border-gray-300" %>
          <% end %>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-6 py-10">
      <% if notice.present? %>
        <p class="mb-6 rounded-lg bg-green-50 px-4 py-3 text-sm text-green-800 border border-green-200"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="mb-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 border border-red-200"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
