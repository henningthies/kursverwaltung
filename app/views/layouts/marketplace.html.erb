<!DOCTYPE html>
<html lang="de">
  <head>
    <title><%= content_for(:title) || "Kursverwaltung" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen antialiased">
    <%= render "shared/marketplace_header" %>

    <% if notice.present? %>
      <div class="max-w-6xl mx-auto px-6 pt-6">
        <p class="rounded-lg bg-green-50 px-4 py-3 text-sm text-green-800 border border-green-200"><%= notice %></p>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="max-w-6xl mx-auto px-6 pt-6">
        <p class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 border border-red-200"><%= alert %></p>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
