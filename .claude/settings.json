{
  "permissions": {
    "deny": [
      "Bash(rm *)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env.sh\"",
            "statusMessage": "Prüfe .env-Zugriff …"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/rubocop-autocorrect.sh\"",
            "statusMessage": "RuboCop -a …"
          }
        ]
      }
    ]
  }
}
